---
const name = 'Aditya Chandra Prajapati';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Aditya Chandra Prajapati · Proof of Work</title>
    <meta name="description" content="I'm Aditya Chandra Prajapati, an Electronics and Telecommunication Engineering graduate (2026) from Pune. This is where my projects live." />
    <link rel="canonical" href="https://air01aditya.github.io/" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content="Aditya Chandra Prajapati · Proof of Work" />
    <meta property="og:description" content="Projects by Aditya Chandra Prajapati, ECE graduate (2026), Pune." />
    <meta property="og:url" content="https://air01aditya.github.io/" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name,
      url: 'https://air01aditya.github.io/',
      address: { '@type': 'PostalAddress', addressLocality: 'Pune', addressCountry: 'IN' },
      sameAs: ['https://github.com/air01aditya'],
    })} />
  </head>
  <body>
    <main>
      <p class="kicker">Proof of Work &middot; ACP.X</p>
      <h1>{name}</h1>
      <p class="note">Site under construction. The pipeline works.</p>
      <p class="note"><a href="/prototypes/site.html">demo &rarr;</a></p>
    </main>

    <style>
      :root {
        color-scheme: light;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #fcfcfb;
        color: #1a1a18;
        font-family: -apple-system, 'Segoe UI', sans-serif;
      }
      main {
        padding: 32px;
        text-align: center;
      }
      .kicker {
        margin: 0 0 12px;
        font-size: 13px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #8a8880;
      }
      h1 {
        margin: 0;
        font-size: clamp(28px, 6vw, 52px);
        font-weight: 600;
        letter-spacing: -0.02em;
      }
      .note {
        margin: 16px 0 0;
        font-size: 15px;
        color: #6b6a63;
      }
      .note a {
        color: inherit;
        text-decoration-color: #c9c7bd;
      }
    </style>
  </body>
</html>
