---
const name = 'Aditya Chandra Prajapati';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Proof of Work · ACP.X</title>
    <meta name="description" content="Portfolio of Aditya Chandra Prajapati." />
  </head>
  <body>
    <main>
      <p class="kicker">Proof of Work &middot; ACP.X</p>
      <h1>{name}</h1>
      <p class="note">Site under construction. The pipeline works.</p>
      <p class="note"><a href="/prototypes/site.html">demo &rarr;</a></p>
    </main>

    <style>
      :root {
        color-scheme: light;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #fcfcfb;
        color: #1a1a18;
        font-family: -apple-system, 'Segoe UI', sans-serif;
      }
      main {
        padding: 32px;
        text-align: center;
      }
      .kicker {
        margin: 0 0 12px;
        font-size: 13px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #8a8880;
      }
      h1 {
        margin: 0;
        font-size: clamp(28px, 6vw, 52px);
        font-weight: 600;
        letter-spacing: -0.02em;
      }
      .note {
        margin: 16px 0 0;
        font-size: 15px;
        color: #6b6a63;
      }
      .note a {
        color: inherit;
        text-decoration-color: #c9c7bd;
      }
    </style>
  </body>
</html>
