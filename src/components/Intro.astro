---
import sig from '../assets/signature-segments.json';

const { viewBox, segments } = sig;
const CAPS = ['A', 'C', 'P'];
const RUNS = ['ditya', 'handra', 'rajapati'];
const get = (k) => segments.find((s) => s.key === k);

// Where each capital sits while the three are still bunched together in the
// middle, before they move apart to make room for the lowercase.
const CANVAS_W = parseFloat(viewBox.split(' ')[2]);
const CLUSTER_GAP = 40;
const capBoxes = CAPS.map((k) => get(k).box);
const clusterW =
  capBoxes.reduce((a, b) => a + b.w, 0) + CLUSTER_GAP * (CAPS.length - 1);
let cursor = CANVAS_W / 2 - clusterW / 2;
const startDx = {};
CAPS.forEach((k, i) => {
  const b = capBoxes[i];
  startDx[k] = +((cursor + b.w / 2) - (b.x + b.w / 2)).toFixed(1);
  cursor += b.w + CLUSTER_GAP;
});
---

<div id="intro" aria-hidden="true">
  <svg id="intro-sig" viewBox={viewBox} xmlns="http://www.w3.org/2000/svg">
    <defs>
      {
        RUNS.map((k) => (
          <mask id={`introMask-${k}`} maskUnits="userSpaceOnUse">
            <path
              class="pen"
              id={`pen-${k}`}
              d={get(k).route}
              pathLength="1"
              fill="none"
              stroke="#fff"
              stroke-width="30"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-dasharray="1 1"
              stroke-dashoffset="1"
            />
          </mask>
        ))
      }
    </defs>
    <g id="intro-scene">
      {
        CAPS.map((k) => (
          <g class="seg" id={`seg-${k}`} data-dx={startDx[k]}>
            <path class="ink" d={get(k).d} />
          </g>
        ))
      }
      {
        RUNS.map((k) => (
          <g class="seg" id={`seg-${k}`} mask={`url(#introMask-${k})`}>
            <path class="ink" d={get(k).d} />
          </g>
        ))
      }
      <circle id="intro-nib" r="6" />
    </g>
  </svg>
</div>

<style>
  /* Hidden by default so a JS failure can never leave a blank sheet covering
     the site. The script only reveals it when it is actually going to play. */
  #intro {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    background: #fcfcfb;
    place-items: center;
    cursor: pointer;
  }
  #intro.playing {
    display: grid;
  }
  #intro-sig {
    width: min(80vw, 1000px);
    height: auto;
    overflow: visible;
  }
  /* potrace emits contours and their counters in one path — without evenodd
     the inside of every closed loop fills solid. */
  #intro-sig path.ink {
    fill: #101010;
    fill-rule: evenodd;
  }
  #intro .seg {
    opacity: 0;
  }
  #intro-nib {
    fill: #101010;
    opacity: 0;
  }
</style>

<script>
  import gsap from 'gsap';

  const SEEN_KEY = 'acp:intro-seen';
  const CAPS = ['A', 'C', 'P'];
  const RUNS = ['ditya', 'handra', 'rajapati'];
  const WRITE_DURATIONS = { ditya: 1.15, handra: 1.0, rajapati: 1.3 };

  const intro = document.getElementById('intro');
  if (intro) {
    let seen = false;
    try {
      seen = sessionStorage.getItem(SEEN_KEY) === '1';
    } catch {
      // private mode, blocked storage — treat as unseen, just play it
    }
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (seen || reduced) {
      dismiss(true);
    } else {
      play();
    }

    function markSeen() {
      try {
        sessionStorage.setItem(SEEN_KEY, '1');
      } catch {
        // nothing to do — it just plays again next navigation
      }
    }

    function dismiss(instant) {
      markSeen();
      if (instant) {
        intro.remove();
        return;
      }
      gsap.to(intro, {
        opacity: 0,
        duration: 0.5,
        ease: 'power2.inOut',
        onComplete: () => intro.remove(),
      });
    }

    function play() {
      intro.classList.add('playing');
      const nib = document.getElementById('intro-nib');

      gsap.set('#intro .seg', { opacity: 0 });
      gsap.set('#intro-nib', { opacity: 0 });
      CAPS.forEach((k) => {
        const el = document.getElementById(`seg-${k}`);
        gsap.set(el, { x: parseFloat(el.dataset.dx || '0'), y: -90 });
      });
      RUNS.forEach((k) => {
        gsap.set(`#pen-${k}`, { attr: { 'stroke-dashoffset': 1 } });
      });

      const tl = gsap.timeline();

      // 1. the three capitals fall in together, still bunched up
      CAPS.forEach((k, i) => {
        tl.to(`#seg-${k}`, { opacity: 1, y: 0, duration: 0.62, ease: 'power3.out' }, i * 0.1);
      });

      // 2. they make space
      CAPS.forEach((k) => {
        tl.to(`#seg-${k}`, { x: 0, duration: 0.95, ease: 'power2.inOut' }, 0.9);
      });

      // 3. the cursive writes itself into the gaps, a nib riding the front
      let at = 1.75;
      RUNS.forEach((k) => {
        const dur = WRITE_DURATIONS[k];
        const path = document.getElementById(`pen-${k}`);
        const total = path.getTotalLength();
        tl.set(`#seg-${k}`, { opacity: 1 }, at);
        tl.set('#intro-nib', { opacity: 1 }, at);
        tl.to(
          `#pen-${k}`,
          {
            attr: { 'stroke-dashoffset': 0 },
            duration: dur,
            ease: 'none',
            onUpdate() {
              const prog = 1 - parseFloat(path.getAttribute('stroke-dashoffset'));
              const pt = path.getPointAtLength(Math.min(1, Math.max(0, prog)) * total);
              nib.setAttribute('cx', pt.x);
              nib.setAttribute('cy', pt.y);
            },
          },
          at
        );
        at += dur - 0.07;
      });
      tl.to('#intro-nib', { opacity: 0, duration: 0.3 }, at);

      // 4. the finished name holds, then the sheet goes to black
      const hold = at + 0.95;
      tl.to('#intro .seg', { opacity: 0, duration: 1.3, ease: 'power2.inOut' }, hold);
      tl.to(intro, { backgroundColor: '#000000', duration: 1.4, ease: 'power2.inOut' }, hold + 0.1);

      // 5. the black lifts, and the page is underneath
      tl.call(() => dismiss(false), undefined, hold + 1.75);

      // any click or key press jumps straight to the end
      const skip = () => {
        tl.kill();
        dismiss(false);
        window.removeEventListener('keydown', skip);
      };
      intro.addEventListener('click', skip, { once: true });
      window.addEventListener('keydown', skip, { once: true });
    }
  }
</script>
